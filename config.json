{
  "lzt": {
    "api_token": "${LZT_API_TOKEN}",
    "check_interval": 10,
    "min_balance_alert": 100.0,
    "enabled": true
  },
  "validator": {
    "timeout": 10,
    "max_retries": 3,
    "max_workers": 20
  },
  "cleaner": {
    "max_workers": 20,
    "max_messages_delete": 20,
    "base_delay": 1.0,
    "min_delay": 0.8,
    "close_channels": true
  },
  "telegram": {
    "bot_token": "${TELEGRAM_BOT_TOKEN}",
    "chat_id": "${TELEGRAM_CHAT_ID}",
    "notification_threshold": 40,
    "allowed_user_ids": "${TELEGRAM_ALLOWED_USER_IDS}"
  },
  "database": {
    "path": "data/tokens.db"
  },
  "proxy": {
    "enabled": true,
    "file": "data/proxies.txt"
  },
  "logging": {
    "level": "INFO",
    "file": "data/logs/pipeline.log"
  },
  "dashboard": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 5000,
    "session_hours": 8
  },
  "live_stats": {
    "enabled": true
  }
}
